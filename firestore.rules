rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Safely reads the caller's role. Returns null if the user document
    // doesn't exist yet (e.g. during initial Google Sign-In) instead of
    // crashing the rule evaluation with a null-dereference error.
    function callerRole() {
      let uid = request.auth.uid;
      return exists(/databases/$(database)/documents/users/$(uid))
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() == 'admin';
    }

    function isDriver() {
      return isSignedIn() && callerRole() == 'driver';
    }

    function isPassenger() {
      return isSignedIn() && callerRole() == 'passenger';
    }

    // ── users ────────────────────────────────────────────────────────────────
    // • Any authenticated user can read their own document.
    // • Users may update only a safe subset of their own fields.
    // • Admins can read and update any user document (e.g. set verificationStatus).
    // • Only the backend / admin SDK creates user documents (no client create/delete).

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Users may create their own document on registration.
      allow create: if isSelf(uid)
        && request.resource.data.role in ['driver', 'passenger']
        && request.resource.data.isBlocked == false;

      // Self: update only personal / vehicle fields — not role or verificationStatus.
      allow update: if (isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['role', 'verificationStatus', 'idFrontUrl', 'idBackUrl', 'createdAt']))
        || isAdmin();

      // Drivers may update their own idFrontUrl / idBackUrl / verificationStatus
      // only when setting status to 'pending' (i.e. submitting for the first time).
      allow update: if isSelf(uid)
        && isDriver()
        && request.resource.data.verificationStatus == 'pending'
        && resource.data.verificationStatus in ['unsubmitted', 'pending'];
    }

    // ── rides ────────────────────────────────────────────────────────────────
    // • Anyone signed in can list / read active rides.
    // • Only the owning driver can create or update their own ride.
    // • Passengers may increment bookedSeats only (handled via transaction).
    // • Admins have full access.

    match /rides/{rideId} {
      allow read: if isSignedIn();

      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.bookedSeats == 0
        && request.resource.data.status == 'active';

      // Driver may update their own ride (e.g. cancel it, accept a booking).
      // Passengers may only decrement bookedSeats (when cancelling a confirmed booking).
      allow update: if isAdmin()
        || (isDriver() && resource.data.driverId == request.auth.uid)
        || (isPassenger()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookedSeats'])
            && request.resource.data.bookedSeats < resource.data.bookedSeats
            && request.resource.data.bookedSeats >= 0);

      allow delete: if isAdmin();
    }

    // ── bookings ─────────────────────────────────────────────────────────────
    // • A passenger can read and create their own bookings.
    // • A driver can read bookings for their rides.
    // • A passenger may update only the status field (to 'cancelled').
    // • Admins have full access.

    match /bookings/{bookingId} {
      allow read: if isAdmin()
        || (isSignedIn() && (
            resource.data.passengerId == request.auth.uid
            || resource.data.driverId == request.auth.uid
            || resource.data.status == 'confirmed'
           ));

      // Passengers create booking requests in 'pending' state.
      allow create: if isPassenger()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.status == 'pending';

      // Passenger may cancel their own pending or confirmed booking.
      // Driver may accept (pending→confirmed), reject (pending→rejected),
      //   cancel or complete (confirmed→cancelled/completed) their own ride's bookings.
      allow update: if isAdmin()
        || (isPassenger()
            && resource.data.passengerId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status == 'cancelled'
            && resource.data.status in ['pending', 'confirmed'])
        || (isDriver()
            && resource.data.driverId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && (
              (resource.data.status == 'pending'
                && request.resource.data.status in ['confirmed', 'rejected'])
              || (resource.data.status == 'confirmed'
                && request.resource.data.status in ['cancelled', 'completed'])
            ));

      allow delete: if isAdmin();
    }

    // ── ratings (passenger rates driver) ────────────────────────────────────
    // • Any signed-in user can read ratings (driver profiles show average).
    // • Only the passenger who made the booking can create a rating.

    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isPassenger()
        && request.resource.data.passengerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── passengerRatings (driver rates passenger) ────────────────────────────
    match /passengerRatings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isDriver()
        && request.resource.data.driverId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── routes ───────────────────────────────────────────────────────────────
    // • Any signed-in user can read routes (needed to fetch the price when
    //   a driver selects origin/destination on the create-ride screen).
    // • Only admins can create, update, or delete route pricing documents.

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── chats ────────────────────────────────────────────────────────────────
    // • Only participants of a chat may read or write it.
    // • Admins may read any chat (moderation).

    match /chats/{chatId} {
      allow read, write: if isAdmin()
        || (isSignedIn()
            && request.auth.uid in resource.data.participants);

      // Allow creating a new chat document when the caller is one of the participants.
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAdmin()
          || (isSignedIn()
              && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);

        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
          && request.resource.data.senderId == request.auth.uid;

        // Messages are immutable once written.
        allow update, delete: if isAdmin();
      }
    }
  }
}
